# Copy to .env.local and fill in at least one key. Real environment variables override this file.

# Provider keys. Each variable may hold several keys separated by commas; they are
# tried in order and a key that is rejected (invalid, out of credit, or a quota that
# grants zero requests) is skipped for the next one. Keys entered in the app's
# Settings are tried before these.
#   GEMINI_API_KEY=first-key,second-key
# Numbered variables work too if you prefer one per line:
#   GEMINI_API_KEY_2=second-key
#   GEMINI_API_KEY_3=third-key
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Default provider: gemini | openrouter (default gemini)
AI_PROVIDER=

# OpenRouter models for the text helpers and audio analysis (default google/gemini-3.5-flash)
OPENROUTER_TEXT_MODEL=
OPENROUTER_ANALYZE_MODEL=

# 1 = mock mode: no provider calls, no cost
LYRIA_MOCK=

# Server port (default 3001)
PORT=
